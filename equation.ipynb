        "    else:\n",
        "        x = (c1 * b2 - c2 * b1) / determinant\n",
        "        y = (a1 * c2 - a2 * c1) / determinant\n",
        "\n",
        "        print(\"Value of x =\", x)\n",
        "        print(\"Value of y =\", y)\n",
        "\n",
